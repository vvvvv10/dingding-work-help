[Unit]
Description=KB Admin - DingTalk group knowledge Q&A
After=network.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/dingtalk-kb-bot
EnvironmentFile=/opt/dingtalk-kb-bot/.env
ExecStart=/opt/dingtalk-kb-bot/.venv/bin/python -m app.main serve --host 127.0.0.1 --port 8017 --with-scheduler
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
