# ---- 必填：后台访问令牌，改成一个长随机串 ----
KB_ADMIN_TOKEN=change-me-to-a-long-random-string
KB_PORT=8000
KB_DB_PATH=./data/kb.sqlite3

# ---- 存储后端：sqlite（默认，单文件开箱即用）/ mysql（多人部署、要备份和扩容时用）----
KB_BACKEND=sqlite
# 只有 KB_BACKEND=mysql 时才读这几行；HOST/PORT 填实际能连到 MySQL 的地址
# 数据库不存在会自动建（utf8mb4 + utf8mb4_unicode_ci）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=dingtalk_kb
MYSQL_TIMEOUT=10

# ---- 钉钉企业内部应用（开放平台 → 应用 → 凭证与基础信息）----
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# 机器人 code，一般与 Client ID 相同，可在「机器人」能力页确认
DINGTALK_ROBOT_CODE=

# ---- DWS（DingTalk Workspace CLI）：拿群全量消息走这条 ----
# 安装：npm install -g dingtalk-workspace-cli
# 登录：dws auth login   （需管理员在开发者后台开启「CLI 访问管理」）
# 找不到命令时用 DWS_BIN 指定绝对路径
DWS_BIN=dws
# 订阅范围：group_all=所有群消息 / group=指定群 / at=只收@我 / o2o_all=所有单聊
DWS_EVENT_KIND=group_all
# 拉历史消息时每条群取多少条
DWS_HISTORY_LIMIT=200
# 多组织账号时指定用哪个 profile（corpId:userId），留空为默认
DWS_PROFILE=

# ---- 大模型（OpenAI 兼容接口，DeepSeek / 通义 / 智谱 / 自建均可）----
# 阿里云百炼：https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-plus
# DeepSeek ：https://api.deepseek.com/v1 + deepseek-chat
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_TIMEOUT=60

# ---- 向量检索（可选，不填则退化为中文关键词检索）----
# 百炼 text-embedding-v3 单次最多 10 条输入，EMBED_BATCH 别调大
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=
EMBED_MODEL=text-embedding-v3
EMBED_BATCH=10
EMBED_DIM=1024

# ---- 权限与流程 ----
# 不在群里的用户直接拒绝检索
ACL_REQUIRE_GROUP_MEMBERSHIP=true
# 未登记用户一律拒绝（更严）
ACL_DENY_UNKNOWN_USER=false
# 提炼出的知识是否免审核直接生效
KNOWLEDGE_AUTO_APPROVE=false
DISTILL_MIN_MESSAGES=3
DISTILL_WINDOW_MINUTES=180
# 定时沉淀的检查间隔（分钟）。越小知识越新鲜，代价是多调几次大模型
DISTILL_INTERVAL_MINUTES=10
RAG_TOP_K=6
RAG_MAX_REPLY_CHARS=1800
# 纯向量召回（关键词零命中）时的最低相似度，低于此值不进上下文
RAG_VEC_MIN_SIM=0.55
